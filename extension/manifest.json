{
  "manifest_version": 3,
  "name": "Tab Lock",
  "version": "2.0.0",
  "description": "Locks the browser to one tab, one site or a lock screen until the password or a phone code is entered. Schedules, timers and a usage log.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Lock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-unlock": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the unlock box (works in fullscreen)"
    }
  },
  "incognito": "spanning"
}
